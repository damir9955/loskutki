# Сервер мультиплеера «Лоскутки» (deno/server.ts) в Docker.
# Зачем: запасной бесплатный хостинг, если Deno Deploy недоступен —
# этот образ запускается на Render.com (render.yaml в корне репозитория,
# план Free) или Koyeb. Файл называется Dockerfile.server, а не
# Dockerfile, чтобы Vercel (где живёт сайт игры) его гарантированно
# игнорировал.
#
# Сборка/запуск локально:
#   docker build -f Dockerfile.server -t loskutki-server .
#   docker run -p 8000:8000 -e PORT=8000 loskutki-server
#
# Хранилище (необязательно, но рекомендуется — данные переживают
# перезапуск): три переменные окружения Cloudflare D1 —
#   D1_ACCOUNT_ID, D1_DATABASE_ID, D1_API_TOKEN
# (инструкция — в шапке deno/server.ts или README, раздел «Хранилище»).

# Проверено на Deno 2.9.6 (пин версии — воспроизводимая сборка).
FROM denoland/deno:2.9.6

WORKDIR /app

# сам сервер — один файл, без зависимостей
COPY deno/server.ts ./server.ts

# Render/большинство PaaS передают порт через PORT
ENV PORT=8000
EXPOSE 8000

# health-проверка хостинга: GET / отвечает страницей «сервер онлайн»
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD deno eval "fetch('http://localhost:' + (Deno.env.get('PORT') ?? '8000') + '/').then(r => r.ok ? Deno.exit(0) : Deno.exit(1)).catch(() => Deno.exit(1))"

CMD ["deno", "run", "--allow-net", "--allow-env", "server.ts"]
