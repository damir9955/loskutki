{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "deno",
    "examples",
    "scripts/run-server-bun.ts",
    "scripts/test-deno-parity.ts",
    "scripts/ws-e2e.ts",
    "scripts/kv-restart-test.ts",
    "scripts/kv-two-isolates-test.ts",
    "scripts/test-gameover.ts",
    "scripts/drive-foe.ts",
    "scripts/join-idle.ts",
    "scripts/test-autopass-persist.ts",
    "scripts/probe-timeout.ts"
  ]
}
